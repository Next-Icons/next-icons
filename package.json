{
	"private": false,
	"type": "module",
	"version": "0.3.0",
	"main": "build/index.js",
	"types": "build/index.d.ts",
	"name": "@deemlol/next-icons",
	"description": "An open-source icon library built for Next.js, focused on simplicity, lightweight performance, and seamless integration. Every icon is carefully designed on a consistent 24x24 pixel grid.",
	"scripts": {
		"build": "rollup -c",
		"lint": "eslint src",
		"generate": "npx tsx scripts/generate-index.ts",
		"format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
		"format:write": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"peerDependencies": {
		"react": ">=17"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "^3.9.10",
		"rollup": "^4.67.4",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	},
	"exports": {
		".": {
			"import": "./build/index.js",
			"default": "./build/index.js",
			"types": "./build/index.d.ts"
		}
	},
	"keywords": [
		"react icons",
		"nextjs icons",
		"svg icons",
		"icons",
		"next icons"
	],
	"files": [
		"build"
	],
	"sideEffects": false,
	"license": "MIT",
	"homepage": "https://www.nexticons.com",
	"bugs": {
		"url": "https://github.com/Next-Icons/next-icons/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Next-Icons/next-icons.git"
	},
	"author": {
		"name": "NextIcons.com",
		"email": "contact@nexticons.com",
		"url": "https://www.nexticons.com"
	}
}
